# Copy to .env and adjust. Everyone adds their own AI provider keys on the
# API keys page (/keys) in the app, so no provider keys go here.

# Encrypts the API keys people save. Use 32+ random characters, keep it secret,
# and never change it once keys are saved (they would need re-entering).
# If left empty, a random one is created in data/secret.key on first run.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KEY_ENCRYPTION_SECRET=

# Optional "house key": your free OpenRouter key (https://openrouter.ai/settings/keys).
# Lets people without their own key use OpenRouter's free models, a few messages
# each per day. It's only ever used for free ($0, ":free") models. On OpenRouter,
# set this key's credit limit to 0 so it can never spend money.
OPENROUTER_HOUSE_KEY=
# Free messages per person per day, and in total per day (OpenRouter's free
# accounts allow 50 a day; 1000 once you've ever bought 10 credits).
HOUSE_DAILY_PER_PERSON=5
HOUSE_DAILY_TOTAL=50

# Optional: make the whole site private. Visitors must enter this code before
# they can see anything or create an account (once per browser). Use a long,
# random phrase. Changing it asks everyone for the new code. Leave empty for an open site.
ACCESS_CODE=

# Keys can only be added over https:// or on this computer (localhost).
# Set to 1 to also allow plain http:// network addresses, only on a home network you trust.
ALLOW_INSECURE_KEYS=

PORT=3000
